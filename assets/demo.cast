{"version": 2, "width": 126, "height": 30, "timestamp": 1789583470, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-ghostty"}}
[0.019781, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.020216, "o", "Harborlight — the Opaque quickstart\r\nApprove the work. Keep secrets secret.\r\n(every value here is synthetic; Harborlight is a fictional lender)\r\n"]
[3.5349, "o", "\r\n═══ Act 1 — The leak ═══\r\n\r\n$ python3 agent/analyst.py debug-env | grep HARBORLIGHT\r\n"]
[3.57417, "o", "  HARBORLIGHT_SOURCE_TOKEN=demo_value_123456\r\n"]
[3.577591, "o", "\r\n(the token reached the transcript — nothing decided, nothing recorded)\r\n"]
[7.090564, "o", "\r\n═══ Act 2 — The policy ═══\r\n\r\n"]
[7.108199, "o", "$ opaque init --preset github-secrets\r\n"]
[7.119894, "o", "\r\n\u001b[1m\u001b[4mInitialized opaque\u001b[0m\r\n  \u001b[32m✔ \u001b[0m Created \u001b[36m/private/tmp/harborlight.SevYYZ/home/.opaque\u001b[0m\r\n  \u001b[32m✔ \u001b[0m Created \u001b[36m/private/tmp/harborlight.SevYYZ/home/.opaque/run\u001b[0m\r\n  \u001b[32m✔ \u001b[0m Created \u001b[36m/private/tmp/harborlight.SevYYZ/home/.opaque/profiles\u001b[0m\r\n  \u001b[32m✔ \u001b[0m Wrote   \u001b[36m/private/tmp/harborlight.SevYYZ/home/.opaque/config.toml\u001b[0m (preset: \u001b[1mgithub-secrets\u001b[0m)\r\n\r\n  \u001b[1mNext steps:\u001b[0m\r\n  \u001b[36m\u001b[1m[1/4]\u001b[0m \u001b[36m\u001b[1mopaque service install\u001b[0m \u001b[2m# install & start daemon\u001b[0m\r\n  \u001b[36m\u001b[1m[2/4]\u001b[0m \u001b[36m\u001b[1mopaque connect auto\u001b[0m \u001b[2m# connect to Claude/Cursor\u001b[0m\r\n  \u001b[36m\u001b[1m[3/4]\u001b[0m \u001b[36m\u001b[1mopaque ping\u001b[0m \u001b[2m# verify daemon is alive\u001b[0m\r\n  \u001b[36m\u001b[1m[4/4]\u001b[0m \u001b[36m\u001b[1mopaque doctor\u001b[0m \u001b[2m# full diagnostic check\u001b[0m\r\n\r\n\u001b[36mℹ \u001b[0m Or run 'opaque quickstart' to do all of the above automatically.\r\n"]
[7.121738, "o", "\r\n"]
[7.126247, "o", "┌────────────────────────────────────────────────────────────────────────┐\r\n│ CI MODE: approvals are synthetic.                                      │\r\n│                                                                        │\r\n│ This run appends approval_backend = \"insecure_auto_approve\" to the     │\r\n│ config and sets OPAQUE_INSECURE_AUTO_APPROVE=1. The daemon will        │\r\n│ approve every request without a human. It announces this with an       │\r\n│ error-level audit event, and every approval is attributed to the       │\r\n│ synthetic approver \"insecure-auto-approve\" in the audit record.        │\r\n│                                                                        │\r\n│ This mode exists for learning and CI. Never use it in production.      │\r\n└─────────────────────────"]
[7.126283, "o", "───────────────────────────────────────────────┘\r\n"]
[7.126676, "o", "$ edit \"$HOME/.opaque/config.toml\"   # prepend data_dir (and, in CI, the insecure backend)\r\n"]
[7.134365, "o", "\r\n$ cat policy/harborlight-extras.toml >> \"$HOME/.opaque/config.toml\"\r\n"]
[7.137195, "o", "\r\n"]
[7.14276, "o", "$ opaque policy check\r\n"]
[7.148974, "o", "\u001b[32m✔ \u001b[0m \u001b[32m\u001b[1mpolicy OK: 8 rules loaded\u001b[0m\r\n"]
[7.150209, "o", "\r\n"]
[9.654261, "o", "$ opaque policy simulate --operation test.noop --client-type agent\r\n"]
[9.664362, "o", "\r\n\u001b[1m\u001b[4mPolicy Simulation\u001b[0m\r\n  \u001b[2moperation:\u001b[0m \u001b[33m\u001b[1mtest.noop\u001b[0m\r\n  \u001b[2mclient:\u001b[0m agent\r\n\r\n"]
[9.664389, "o", "\u001b[32m✔ \u001b[0m \u001b[32m\u001b[1mALLOW (rule: allow-test-noop)\u001b[0m\r\n  \u001b[2mapproval:\u001b[0m firstuse\r\n  \u001b[2mfactors:\u001b[0m LocalBio\r\n  \u001b[2mlease:\u001b[0m 300s\r\n"]
[9.665461, "o", "\r\n"]
[12.677879, "o", "$ opaque policy simulate --operation gitlab.set_ci_variable --client-type agent\r\n"]
[12.690585, "o", "\r\n\u001b[1m\u001b[4mPolicy Simulation\u001b[0m\r\n  \u001b[2moperation:\u001b[0m \u001b[33m\u001b[1mgitlab.set_ci_variable\u001b[0m\r\n  \u001b[2mclient:\u001b[0m agent\r\n\r\n\u001b[31m✖ \u001b[0m \u001b[31m\u001b[1mDENY: no matching policy rule (default deny)\u001b[0m\r\n"]
[12.691874, "o", "\r\n"]
[16.196302, "o", "\r\n═══ Act 4 — The receipt ═══\r\n\r\n"]
[16.196685, "o", "$ opaqued   # started in the background; log: /private/tmp/harborlight.SevYYZ/logs/opaqued.log\r\n"]
[16.198327, "o", "\r\n"]
[16.264038, "o", "$ opaque ping\r\n"]
[16.270543, "o", "\u001b[36m⠋\u001b[0m Calling ping...                                                                                                             "]
[16.270575, "o", "\r\u001b[2K\u001b[36m⠙\u001b[0m Calling ping...                                                                                                             "]
[16.318098, "o", "\r\u001b[2K\u001b[32m✔ \u001b[0m \u001b[32m\u001b[1mPong\u001b[0m\r\n"]
[16.319284, "o", "\r\n"]
[17.534711, "o", "$ opaque gitlab set-ci-variable --project tutorial/denied --key TUTORIAL_KEY --value-ref keychain:opaque/tutorial-value\r\n"]
[17.551572, "o", "\u001b[36m⠋\u001b[0m Calling gitlab...                                                                                                           "]
[17.551894, "o", "\r\u001b[2K\u001b[36m⠙\u001b[0m Calling gitlab...                                                                                                           "]
[17.610328, "o", "\r\u001b[2K\u001b[31m✖ \u001b[0m \u001b[31m\u001b[1mpolicy denied: operation 'gitlab.set_ci_variable' denied by policy — debug with: opaque policy simulate --operation gitlab.set_ci_variable\u001b[0m\r\n"]
[17.610358, "o", "  \u001b[2mcode:\u001b[0m \u001b[31m\u001b[2mpolicy_denied\u001b[0m\r\n\r\n  \u001b[36m\u001b[1mhint:\u001b[0m This operation was denied by the security policy.\r\n    • Check policy: \u001b[33mopaque policy show\u001b[0m\r\n    • Request approval or check pending leases: \u001b[33mopaque leases\u001b[0m\r\n"]
[17.611168, "o", "\r\n"]
[20.118128, "o", "$ opaque audit tail --kind policy.denied --limit 1\r\n"]
[20.132147, "o", "\r\n\u001b[1m\u001b[4mAudit log — 1 event(s)\u001b[0m\r\n  \u001b[1m\u001b[2mWHEN                              EVENT          OPERATION               OUTCOME   REQUEST ID                          \u001b[0m\r\n  \u001b[2m────────────────────────────────  ─────────────  ──────────────────────  ────────  ────────────────────────────────────\u001b[0m\r\n  2s ago  \u001b[2m2026-09-16T18:31:27.913Z\u001b[0m  policy.denied  gitlab.set_ci_variable  \u001b[31m\u001b[1m[denied]\u001b[0m  2e34c2e8-12f9-4e3a-b1fa-6b18737bd9a5\r\n\r\n\u001b[36mℹ \u001b[0m Showing 1 of many events. Use --limit 11 to see more.\r\n"]
[20.133234, "o", "\r\n"]
[23.148839, "o", "$ opaque audit verify\r\n"]
[23.166749, "o", "\u001b[32m✔ \u001b[0m \u001b[32m\u001b[1mAudit chain intact — 7 records verified\u001b[0m\r\n"]
[23.168747, "o", "\r\n"]
[26.686443, "o", "\r\n═══ Falsify it ═══\r\n\r\n$ kill $OPAQUED_PID   # stop the daemon before tampering with its database\r\n"]
[26.696502, "o", "\r\n"]
[26.696681, "o", "$ sqlite3 \"$HOME/.opaque/audit.db\" \\\r\n    \"update audit_events set detail='tampered' where rowid=(select max(rowid) from audit_events);\"\r\n"]
[26.733231, "o", "\r\n$ opaque audit verify\r\n"]
[26.748222, "o", "\u001b[31m✖ \u001b[0m \u001b[31m\u001b[1mAudit chain BROKEN — audit chain broken at record 7 (sequence 6) (6 records verified before the break)\u001b[0m\r\n"]
[26.749387, "o", "\r\n"]
[26.749465, "o", "Tamper detected: verify exits non-zero and names the record where the chain broke.\r\n\r\n"]
[26.749496, "o", "github.com/kcirtapfromspace/harborlight — the full story is four acts.\r\n"]
